{
  "manifest_version": 1,
  "type": "device",
  "name": "NHC Hurricanes",
  "description": {
    "en": "Tropical storms and hurricanes of the US National Hurricane Center near your home.",
    "fr": "Tempêtes tropicales et ouragans du National Hurricane Center américain près de chez vous.",
    "de": "Tropische Stürme und Hurrikane des US National Hurricane Center nahe deinem Zuhause.",
    "es": "Tormentas tropicales y huracanes del National Hurricane Center de EE. UU. cerca de su casa."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-nhc:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-nhc/main/cover.png",
  "categories": ["environment", "security"],
  "transports": ["cloud"],
  "location": true,
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your home",
        "fr": "Votre maison",
        "de": "Dein Zuhause",
        "es": "Su casa"
      },
      "description": {
        "en": "Tropical storms and hurricanes of the US National Hurricane Center: Atlantic, Eastern and Central Pacific. Distances are computed in Gladys from your house (or coordinates), never sent. Save, then create the devices in the Discover tab.",
        "fr": "Tempêtes tropicales et ouragans du National Hurricane Center américain : Atlantique, Pacifique Est et Central. Les distances sont calculées dans Gladys depuis votre maison (ou des coordonnées), jamais envoyées. Enregistrez, puis créez les appareils dans l'onglet Découverte.",
        "de": "Tropische Stürme und Hurrikane des US National Hurricane Center: Atlantik, Ost- und Zentralpazifik. Entfernungen werden in Gladys ab deinem Haus (oder Koordinaten) berechnet, nie gesendet. Speichere und lege dann die Geräte im Tab „Entdecken“ an.",
        "es": "Tormentas tropicales y huracanes del National Hurricane Center de EE. UU.: Atlántico, Pacífico Este y Central. Las distancias se calculan en Gladys desde su casa (o coordenadas), nunca se envían. Guarde y cree los dispositivos en la pestaña Descubrir."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-nhc/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide d'installation",
            "de": "Installationsanleitung",
            "es": "Guía de instalación"
          }
        }
      ]
    },
    {
      "key": "about",
      "type": "section",
      "label": {
        "en": "Sources and limits",
        "fr": "Sources et limites",
        "de": "Quellen und Grenzen",
        "es": "Fuentes y límites"
      },
      "description": {
        "en": "Data of NOAA's National Hurricane Center (public domain), read without an account. Not an official alert service: follow the instructions of your local authorities. Not affiliated with NOAA.",
        "fr": "Données du National Hurricane Center de la NOAA (domaine public), lues sans compte. Pas un service d'alerte officiel : suivez les consignes des autorités locales. Non affiliée à la NOAA.",
        "de": "Daten des National Hurricane Center der NOAA (gemeinfrei), ohne Konto gelesen. Kein offizieller Warndienst: Befolge die Anweisungen deiner örtlichen Behörden. Nicht mit der NOAA verbunden.",
        "es": "Datos del National Hurricane Center de la NOAA (dominio público), leídos sin cuenta. No es un servicio de alerta oficial: siga las instrucciones de sus autoridades locales. Sin afiliación con la NOAA."
      },
      "links": [
        {
          "url": "https://www.nhc.noaa.gov",
          "label": {
            "en": "NHC website",
            "fr": "Site du NHC",
            "de": "Website des NHC",
            "es": "Sitio web del NHC"
          }
        }
      ]
    },
    {
      "key": "latitude",
      "type": "string",
      "label": {
        "en": "Home latitude",
        "fr": "Latitude de la maison",
        "de": "Breitengrad des Zuhauses",
        "es": "Latitud de la casa"
      },
      "description": {
        "en": "Leave both coordinates empty to use the location of your house in Gladys.",
        "fr": "Laissez les deux coordonnées vides pour utiliser la position de votre maison dans Gladys.",
        "de": "Lass beide Koordinaten leer, um den Standort deines Hauses in Gladys zu verwenden.",
        "es": "Deje ambas coordenadas vacías para usar la ubicación de su casa en Gladys."
      },
      "placeholder": {
        "en": "e.g. 25.7617",
        "fr": "ex. 16,2411",
        "de": "z. B. 25.7617",
        "es": "p. ej. 18.4655"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "longitude",
      "type": "string",
      "label": {
        "en": "Home longitude",
        "fr": "Longitude de la maison",
        "de": "Längengrad des Zuhauses",
        "es": "Longitud de la casa"
      },
      "description": {
        "en": "Decimal degrees, east positive (west is negative).",
        "fr": "Degrés décimaux, positifs à l'est (l'ouest est négatif).",
        "de": "Dezimalgrad, Osten positiv (Westen negativ).",
        "es": "Grados decimales, positivos al este (el oeste es negativo)."
      },
      "placeholder": {
        "en": "e.g. -80.1918",
        "fr": "ex. -61,5331",
        "de": "z. B. -80.1918",
        "es": "p. ej. -66.1057"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "basins",
