      "label": {
        "en": "Basins",
        "fr": "Bassins",
        "de": "Becken",
        "es": "Cuencas"
      },
      "description": {
        "en": "One device per followed basin. The nearest storm is looked for in these basins only.",
        "fr": "Un appareil par bassin suivi. La tempête la plus proche n'est cherchée que dans ces bassins.",
        "de": "Ein Gerät pro verfolgtem Becken. Der nächste Sturm wird nur in diesen Becken gesucht.",
        "es": "Un dispositivo por cuenca seguida. La tormenta más cercana solo se busca en estas cuencas."
      },
      "required": false,
      "default": ["atlantic", "eastern_pacific", "central_pacific"],
      "options": [
        {
          "value": "atlantic",
          "label": {
            "en": "Atlantic",
            "fr": "Atlantique",
            "de": "Atlantik",
            "es": "Atlántico"
          }
        },
        {
          "value": "eastern_pacific",
          "label": {
